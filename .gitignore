# ============================================================
# 项目根目录 .gitignore
# 城市内涝监测预警系统（ESP32 硬件 + Spring Boot 后端 + Python + Vue 前端）
# ============================================================

# ---------- 敏感信息（切勿提交，防泄露） ----------
# ESP32 固件敏感配置：Wi-Fi 密码、服务器 IP、MQTT 账号
secrets.h
# 环境变量（真实密钥），模板 .env.example 仍会提交
.env
.env.local

# ---------- ESP32 硬件 / 嵌入式编译产物 ----------
# PlatformIO 编译目录
.pio/
# Arduino IDE 编译目录
build/
# 固件烧录二进制 / 链接产物
*.bin
*.elf
*.hex
*.map

# ---------- Java 编译产物 ----------
target/
*.class

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/

# ---------- Node.js 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 前端构建产物 ----------
dist/
out/

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.iml

# ---------- 系统 / 日志 ----------
.DS_Store
Thumbs.db
*.log
