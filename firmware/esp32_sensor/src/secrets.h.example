/**
 * secrets.h.example
 * =================
 * 敏感信息模板。请复制为 secrets.h 并填入真实值：
 *   cp secrets.h.example secrets.h
 *
 * secrets.h 已加入 .gitignore，不会被提交到版本库。
 */
#pragma once

// ======================= Wi-Fi =======================
#define WIFI_SSID           "your-wifi-ssid"
#define WIFI_PASSWORD       "your-wifi-password"

// ======================= 服务器地址 =======================
#define SERVER_HOST         "192.168.1.100"   // MQTT Broker / CoAP 服务端地址
#define MQTT_PORT           1883
#define COAP_PORT           5683

// ======================= MQTT 账号（可选） =======================
// 若 Broker 开启匿名访问，可留空字符串
#define MQTT_USERNAME       "Wangwei"
#define MQTT_PASSWORD       "123456"

// ======================= 站点编号 =======================
// 需与后端 station 表的 code 保持一致（如 S001），或使用新编号触发自动注册
#define STATION_ID          "S001"

// ======================= NB-IoT（SIM7020）AT 指令预留 =======================
// 默认走 Wi-Fi；如改用 NB-IoT 模块，设置 ENABLE_NBIOT=1 并填入以下参数。
#define ENABLE_NBIOT        0
#define NBIOT_APN           "cmnbiot"          // 运营商 APN
#define NBIOT_BAND          "8"                // 频段（电信/联通常见 B8）
#define NBIOT_TX_PIN        26                 // 与 NB-IoT 模块通信的串口 TX
#define NBIOT_RX_PIN        27                 // 与 NB-IoT 模块通信的串口 RX
