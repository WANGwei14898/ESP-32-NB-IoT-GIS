# =====================================================
# 短时水位预测服务 —— 环境变量示例
# 使用方式：复制本文件为 .env 并按需修改
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =====================================================

# ---------- MySQL 数据库连接 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=flood_monitor

# ---------- 预测参数 ----------
# 读取过去多少分钟的历史数据（默认 2 小时）
PREDICT_WINDOW_MINUTES=120
# 滑动平均平滑窗口（分钟）
SMOOTH_WINDOW_MINUTES=5
# 预测模型：moving_average（滑动平均外推）/ arima（statsmodels）
PREDICT_MODEL=moving_average
# 预测时长（分钟，30~60）
PREDICT_HORIZON_MINUTES=60
# 预测步长（分钟）
PREDICT_STEP_MINUTES=5
# ARIMA 所需最少历史点数（不足自动降级为移动平均）
MIN_POINTS_FOR_ARIMA=30

# ---------- 服务配置 ----------
# 定时任务间隔（秒）
PREDICT_SCHEDULE_SECONDS=300
# HTTP 服务端口
PREDICT_PORT=8000
