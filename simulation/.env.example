# =====================================================
# 城市内涝监测预警系统 —— 模拟器环境变量示例
# 使用方式：复制本文件为 .env 并按需修改
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =====================================================

# ---------- MQTT Broker 配置 ----------
MQTT_BROKER=localhost
MQTT_PORT=1883

# ---------- CoAP 服务端配置 ----------
COAP_HOST=localhost
COAP_PORT=5683

# ---------- 上报协议：mqtt 或 coap ----------
PROTOCOL=mqtt

# ---------- 启动的站点数量（默认启动全部站点） ----------
STATION_COUNT=8

# ---------- 上报间隔（秒），1~5 分钟可配置 ----------
# REPORT_INTERVAL 为基准间隔；程序实际会在 [REPORT_INTERVAL_MIN, REPORT_INTERVAL_MAX] 内随机取值
REPORT_INTERVAL=60
REPORT_INTERVAL_MIN=60
REPORT_INTERVAL_MAX=300
