# =====================================================
# 城市内涝监测预警系统 —— 模拟器环境变量示例
# 使用方式：复制本文件为 .env 并按需修改
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =====================================================

# ---------- MQTT Broker 配置 ----------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=Wangwei
MQTT_PASSWORD=123456

# ---------- CoAP 服务端配置 ----------
COAP_HOST=localhost
COAP_PORT=5683

# ---------- 上报协议：mqtt 或 coap ----------
PROTOCOL=mqtt

# ---------- 上报间隔（秒），程序会在该区间内随机取值（1~5 分钟） ----------
REPORT_INTERVAL_MIN=60
REPORT_INTERVAL_MAX=300

