# =====================================================
# 城市内涝监测预警系统 —— 模拟器环境变量示例
# 使用方式：复制本文件为 .env 并按需修改
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =====================================================

# ---------- MQTT Broker 配置 ----------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=Wangwei
MQTT_PASSWORD=123456

# ---------- CoAP 服务端配置 ----------
COAP_HOST=localhost
COAP_PORT=5683

# ---------- 上报协议：mqtt 或 coap ----------
PROTOCOL=mqtt

# ---------- 启动的站点数量（默认启动全部站点） ----------
STATION_COUNT=8

# ---------- 数据来源标识（上报 JSON 的 source 字段） ----------
# 模拟器固定为 simulator；真实 ESP32 固件上报 esp32
SOURCE=simulator

# ---------- 模拟站点编号 ----------
# 留空：使用 STATIONS 列表默认编号（S001~S010）
# sim_station_01：使用模拟专用编号（避免与真实硬件冲突）
# S001：与真实硬件共用同一站点编号，模拟真实环境
SIM_STATION_ID=

# ---------- 上报间隔（秒），1~5 分钟可配置 ----------
# REPORT_INTERVAL 为基准间隔；程序实际会在 [REPORT_INTERVAL_MIN, REPORT_INTERVAL_MAX] 内随机取值
REPORT_INTERVAL=60
REPORT_INTERVAL_MIN=60
REPORT_INTERVAL_MAX=300
